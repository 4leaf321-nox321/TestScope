        "resolve",
        "list_conditions",
        "search_test_items",
        "get_guide"
      ],
      "must_call": [
        "search_test_items"
      ],
      "must_not_call": [
        "search_catalog",
        "create_series",
        "register_equipment"
      ],
      "max_calls": 5
    },
    {
      "id": "q02",
      "text": "인장강도 잴 수 있는 장비 찾아줘",

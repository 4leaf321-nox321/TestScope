# 이 파일을 .env 로 복사해서 쓴다. **BOM 없이 UTF-8 로 저장한다** —
# BOM 이 붙으면 첫 줄 키가 조용히 무시된다(app/config.py 주석 참고).
APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/testscope
# 백엔드가 들을 자리. **개발 run.py 는 이 값 +1(8021)을 쓴다** — vite 프록시와 MCP 가
# 그 규칙을 따라 주소를 맞춘다. 0.0.0.0 은 IPv4 전역이라 확인은 127.0.0.1 로 한다.
HOST=0.0.0.0
PORT=8020
# 운영에서는 반드시 난수로 바꾼다. 기본값이면 기동을 거부한다.
JWT_SECRET=dev-only-insecure-secret-change-me

# 의미 검색 (선택) — setup_ollama.ps1 이 찍어 주는 값. off 면 검색은 이름·별칭으로만 돈다
EMBEDDING_BACKEND=off
OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# MCP (AI 연결, 선택) — 여기 적는 값은 **백엔드가 아니라 MCP 서버**가 읽는다.
# mcp_server\run_mcp.ps1(개발) · 배포판 run_mcp.ps1 · 서비스 정의 셋이 모두
# mcp_server\server.py 를 띄우고, 그 server.py 가 이 파일을 직접 읽는다(환경변수가
# 비어 있을 때만 — 인자로 준 것이 이긴다).
# 백엔드 Settings 는 모르는 키를 무시하므로(extra="ignore") 같은 파일에 둬도 안전하다.
# 서버 주소(TESTSCOPE_API_BASE)는 여기 적지 않는다 — 위의 PORT·APP_ENV 로 계산한다
# (개발은 PORT+1, 운영은 PORT). 두 군데 적으면 언젠가 한쪽만 고치게 된다.
MCP_PORT=8022
MCP_HOST=127.0.0.1
#
# 밖(다른 PC)에서 각자 붙게 하려면 위를 0.0.0.0 으로 바꾸고 **아래를 반드시** 채운다.
# 비워 두면 서버가 기동을 거절한다 — 공식 SDK 는 듣는 자리가 localhost 일 때만 DNS
# rebinding 보호를 저절로 켜므로, 0.0.0.0 으로 바꾸는 것만으로 Host·Origin 검사가
# 조용히 사라지기 때문이다(실측 2026-09-28: 같은 서버에서 바인딩만 바꾸면
# `Host: evil.example` 이 421 에서 200 으로 바뀐다).
#
# **쓰는 사람이 등록에 적는 주소를 그대로**(포트까지) 넣는다. 서버는 요청의 Host
# 헤더와 이 값을 **글자 그대로** 견준다 — 허용에 `127.0.0.1:8022` 만 있으면 같은
# 서버라도 `localhost:8022` 로 들어온 요청은 421 로 거절된다. 이름이 다르면 다른 것이다.
#
#   MCP_ALLOWED_HOSTS=10.240.25.85:8022                   ← 운영 서버 주소 하나
#   MCP_ALLOWED_HOSTS=10.240.25.85:8022,127.0.0.1:8022    ← 쉼표로 여럿
#   MCP_ALLOWED_HOSTS=10.240.25.85:*                      ← 포트만 아무거나
#
# 와일드카드는 `호스트:*`(포트 자리) 하나뿐이다 — 주소 자리에는 못 쓴다.
# **적은 것만 통한다** — 밖에 열면 localhost 가 저절로 붙지 않는다. 서버 자신에서도
# 붙어 볼 것이면 `127.0.0.1:8022` 를 목록에 함께 적는다(안 적으면 거기서도 421 이다).
# 방화벽에 TCP 8022 인바운드도 함께 연다 — install.ps1 은 백엔드 포트만 연다.
MCP_ALLOWED_HOSTS=

# HWAX 포털 연결 (선택) — 게이트웨이가 공유 비밀로 **그 사람의 읽기 전용 토큰**을 받아 간다.
# SSO 가 아니다: TestScope 에 이미 있고 승인된 계정에만 내주고, 계정을 만들지 않는다.
# 비면 창구가 아예 없다(404). 값은 포털 운영자가 만들어(openssl rand -hex 32) 양쪽에 같은
# 값으로 넣는다 — **이쪽이 먼저**다(포털 쪽에 비밀이 생기는 순간 위임 전용이 된다). 배포.md 참고.
HEAX_SSO_SECRET=
# 창구를 부를 수 있는 IP(쉼표). 비면 비밀만 맞으면 된다. 프록시 뒤면 프록시 주소.
HEAX_SSO_ALLOWED_IPS=

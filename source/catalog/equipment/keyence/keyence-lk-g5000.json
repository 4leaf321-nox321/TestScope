{
  "id": "keyence-lk-g5000",
  "kind": "equipment_series",
  "name": "LK-G5000 Series Ultra High-Speed/High-Accuracy Laser Displacement Sensor",
  "name_ko": "키엔스 LK-G5000 초고속·고정밀 레이저 변위 센서",
